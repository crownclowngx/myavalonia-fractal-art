<UserControl
    x:Class="FractalArtPlugin.Features.Main.MainView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:FractalArtPlugin.Features.Main"
    x:DataType="vm:MainDocument">
  <StackPanel Margin="24" Spacing="12">
    <TextBlock FontSize="24" Text="FractalArtPlugin" />
    <TextBlock Text="同一个 View 和 ViewModel 可以独立预览，也可以由 Host 创建。" TextWrapping="Wrap" />
    <TextBox PlaceholderText="输入一些内容" Text="{Binding Message}" />
  </StackPanel>
</UserControl>
