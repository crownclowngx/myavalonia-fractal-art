<UserControl
    x:Class="FractalArtPlugin.Features.Artwork.FractalArtworkView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:FractalArtPlugin.Features.Artwork"
    x:DataType="vm:FractalArtworkDocument">
  <Grid Background="#0A0E1C" RowDefinitions="Auto,*,Auto">
    <Border Grid.Row="0" Padding="14,10" Background="#12182B" BorderBrush="#27304A" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto,Auto" ColumnSpacing="8">
        <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="20" FontWeight="SemiBold" Foreground="#F2F5FF" Text="分形作品" />
        <Button Grid.Column="1" Command="{Binding UndoCommand}" Content="撤销" IsEnabled="{Binding CanUndo}" />
        <Button Grid.Column="2" Command="{Binding RedoCommand}" Content="重做" IsEnabled="{Binding CanRedo}" />
        <CheckBox Grid.Column="4" VerticalAlignment="Center" Foreground="#D4DAED" Content="精细预览" IsChecked="{Binding HighQualityPreview}" />
        <Button Grid.Column="5" Command="{Binding RefreshPreviewCommand}" Content="重新预览" />
        <Button Grid.Column="6" Command="{Binding ExportPngCommand}" Content="导出 PNG" />
      </Grid>
    </Border>

    <Grid Grid.Row="1" ColumnDefinitions="150,*,300">
      <Border Grid.Column="0" Padding="12" Background="#0E1425" BorderBrush="#27304A" BorderThickness="0,0,1,0">
        <StackPanel Spacing="8">
          <TextBlock Margin="4,0,0,8" FontSize="12" Foreground="#8791AD" Text="创作导航" />
          <Button HorizontalContentAlignment="Left" Content="生成" />
          <Button HorizontalContentAlignment="Left" Content="造型（后续阶段）" IsEnabled="False" />
          <Button HorizontalContentAlignment="Left" Content="图层（后续阶段）" IsEnabled="False" />
          <Button HorizontalContentAlignment="Left" Content="效果（后续阶段）" IsEnabled="False" />
          <Button HorizontalContentAlignment="Left" Content="动画（后续阶段）" IsEnabled="False" />
          <Border Margin="0,12,0,0" Padding="10" Background="#182038" CornerRadius="6">
            <TextBlock Foreground="#AEB8D2" Text="G0003 已提供 Julia 单生成器；未实现的能力明确禁用，不以占位按钮伪造。" TextWrapping="Wrap" />
          </Border>
        </StackPanel>
      </Border>

      <Border
          x:Name="CanvasInteractionSurface"
          Grid.Column="1"
          Margin="18"
          Background="#03050C"
          BorderBrush="#394463"
          BorderThickness="1"
          CornerRadius="8"
          Cursor="SizeAll"
          PointerCaptureLost="HandlePointerCaptureLost"
          PointerMoved="HandlePointerMoved"
          PointerPressed="HandlePointerPressed"
          PointerReleased="HandlePointerReleased"
          PointerWheelChanged="HandlePointerWheelChanged">
        <Grid>
          <Image Margin="12" Source="{Binding PreviewImage}" Stretch="Uniform" />
          <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#77819D" FontSize="16"
                     IsVisible="{Binding IsPreviewEmpty}"
                     Text="正在生成可重复的 Julia 预览…" />
        </Grid>
      </Border>

      <ScrollViewer Grid.Column="2" Background="#0E1425" BorderBrush="#27304A" BorderThickness="1,0,0,0">
        <StackPanel Margin="16" Spacing="10">
          <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="#F2F5FF" Text="作品属性" />
          <TextBlock Foreground="#8791AD" Text="画布" />
          <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
            <NumericUpDown Grid.Column="0" Minimum="64" Maximum="8192" Value="{Binding CanvasWidth}" PlaceholderText="宽度" />
            <NumericUpDown Grid.Column="1" Minimum="64" Maximum="8192" Value="{Binding CanvasHeight}" PlaceholderText="高度" />
          </Grid>
          <TextBox Text="{Binding BackgroundHex}" PlaceholderText="#RRGGBBAA 背景" />
          <NumericUpDown Minimum="-9223372036854775808" Maximum="9223372036854775807" Value="{Binding Seed}" PlaceholderText="Seed" />

          <Separator Margin="0,6" />
          <TextBlock Foreground="#8791AD" Text="Julia 形态" />
          <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
            <TextBox Grid.Column="0" Text="{Binding CenterX}" PlaceholderText="中心 X" />
            <TextBox Grid.Column="1" Text="{Binding CenterY}" PlaceholderText="中心 Y" />
          </Grid>
          <TextBox Text="{Binding Scale}" PlaceholderText="视野尺度，例如 1e-80" />
          <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
            <TextBox Grid.Column="0" Text="{Binding ConstantReal}" PlaceholderText="常量实部" />
            <TextBox Grid.Column="1" Text="{Binding ConstantImaginary}" PlaceholderText="常量虚部" />
          </Grid>
          <NumericUpDown Increment="16" Minimum="16" Maximum="4096" Value="{Binding MaxIterations}" PlaceholderText="最大迭代" />
          <CheckBox Content="强制任意精度（深度缩放时会自动启用）" IsChecked="{Binding ForceHighPrecision}" />
          <NumericUpDown Increment="16" Minimum="32" Maximum="1024" Value="{Binding PrecisionDigits}" PlaceholderText="十进制有效位数" />
          <TextBlock Foreground="#8791AD" Text="画布上拖动可平移；滚轮会以鼠标位置为锚点缩放。数值支持科学计数法。" TextWrapping="Wrap" />

          <Separator Margin="0,6" />
          <TextBlock Foreground="#8791AD" Text="线性渐变" />
          <TextBox Text="{Binding GradientStartHex}" PlaceholderText="起始 #RRGGBBAA" />
          <TextBox Text="{Binding GradientEndHex}" PlaceholderText="结束 #RRGGBBAA" />

          <Button Margin="0,8,0,0" Command="{Binding CancelOperationCommand}" Content="取消当前渲染/导出" IsEnabled="{Binding IsOperationBusy}" />
        </StackPanel>
      </ScrollViewer>
    </Grid>

    <Border Grid.Row="2" Padding="12,8" Background="#12182B" BorderBrush="#27304A" BorderThickness="0,1,0,0">
      <TextBlock Foreground="#BFC7DB" Text="{Binding StatusMessage}" TextTrimming="CharacterEllipsis" />
    </Border>
  </Grid>
</UserControl>
