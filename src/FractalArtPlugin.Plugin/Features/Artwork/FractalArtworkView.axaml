<UserControl
    x:Class="FractalArtPlugin.Features.Artwork.FractalArtworkView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:FractalArtPlugin.Features.Artwork"
    x:DataType="vm:FractalArtworkDocument">
  <Grid Background="#0A0E1C" RowDefinitions="Auto,*,Auto,Auto">
    <Border Grid.Row="0" Padding="14,10" Background="#12182B" BorderBrush="#27304A" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto,Auto,Auto" ColumnSpacing="8">
        <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="20" FontWeight="SemiBold" Foreground="#F2F5FF" Text="分形作品" />
        <Button Grid.Column="1" Command="{Binding UndoCommand}" Content="撤销" IsEnabled="{Binding CanUndo}" />
        <Button Grid.Column="2" Command="{Binding RedoCommand}" Content="重做" IsEnabled="{Binding CanRedo}" />
        <Button Grid.Column="3" Command="{Binding GenerateVariationsCommand}" Content="生成九宫格" />
        <CheckBox Grid.Column="5" VerticalAlignment="Center" Foreground="#D4DAED" Content="精细预览" IsChecked="{Binding HighQualityPreview}" />
        <Button Grid.Column="6" Command="{Binding RefreshPreviewCommand}" Content="重新预览" />
        <Button Grid.Column="7" Command="{Binding ExportPngCommand}" Content="导出 PNG" />
      </Grid>
    </Border>

    <Grid Grid.Row="1" ColumnDefinitions="190,*,380">
      <Border Grid.Column="0" Padding="12" Background="#0E1425" BorderBrush="#27304A" BorderThickness="0,0,1,0">
        <Grid RowDefinitions="Auto,*,Auto" RowSpacing="8">
          <StackPanel Grid.Row="0" Spacing="6">
            <TextBlock Margin="4,0,0,4" FontSize="12" Foreground="#8791AD" Text="图层（最上层在前）" />
            <WrapPanel>
              <Button Margin="0,0,4,4" Padding="7,3" Command="{Binding AddLayerCommand}" CommandParameter="Julia" Content="+ Julia" />
              <Button Margin="0,0,4,4" Padding="7,3" Command="{Binding AddLayerCommand}" CommandParameter="Mandelbrot" Content="+ Mandelbrot" />
              <Button Margin="0,0,4,4" Padding="7,3" Command="{Binding AddLayerCommand}" CommandParameter="LSystem" Content="+ L-System" />
              <Button Margin="0,0,4,4" Padding="7,3" Command="{Binding AddLayerCommand}" CommandParameter="RecursiveTree" Content="+ 递归树" />
              <Button Margin="0,0,4,4" Padding="7,3" Command="{Binding AddLayerCommand}" CommandParameter="StrangeAttractor" Content="+ 吸引子" />
              <Button Margin="0,0,4,4" Padding="7,3" Command="{Binding AddGroupCommand}" Content="+ 分组" />
            </WrapPanel>
          </StackPanel>
          <ScrollViewer Grid.Row="1">
            <ItemsControl ItemsSource="{Binding LayerItems}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Margin="0,0,0,5" Padding="5" Background="#182038" CornerRadius="4">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="4">
                      <Button Grid.Column="0" Padding="5,2" Click="HandleToggleLayerVisibility" Content="{Binding VisibilityMark}" />
                      <Button Grid.Column="1" HorizontalContentAlignment="Left" Padding="5,2" Click="HandleSelectLayer" Content="{Binding DisplayName}" />
                      <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="10" Foreground="#8791AD" Text="{Binding KindName}" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
          <StackPanel Grid.Row="2" Spacing="5">
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="4">
              <Button Grid.Column="0" Command="{Binding MoveLayerUpCommand}" Content="上移" />
              <Button Grid.Column="1" Command="{Binding MoveLayerDownCommand}" Content="下移" />
              <Button Grid.Column="2" Command="{Binding DeleteLayerCommand}" Content="删除" />
            </Grid>
            <ComboBox ItemsSource="{Binding GroupOptions}" SelectedItem="{Binding SelectedTargetGroup}" PlaceholderText="目标分组" />
            <Grid ColumnDefinitions="*,*" ColumnSpacing="4">
              <Button Grid.Column="0" Command="{Binding MoveIntoGroupCommand}" IsEnabled="{Binding CanMoveSelectedIntoGroup}" Content="移入组" />
              <Button Grid.Column="1" Command="{Binding MoveOutOfGroupCommand}" IsEnabled="{Binding CanMoveSelectedOutOfGroup}" Content="移出组" />
            </Grid>
          </StackPanel>
        </Grid>
      </Border>

      <Border
          x:Name="CanvasInteractionSurface"
          Grid.Column="1"
          Margin="18"
          Background="#03050C"
          BorderBrush="#394463"
          BorderThickness="1"
          CornerRadius="8"
          Cursor="SizeAll"
          PointerCaptureLost="HandlePointerCaptureLost"
          PointerMoved="HandlePointerMoved"
          PointerPressed="HandlePointerPressed"
          PointerReleased="HandlePointerReleased"
          PointerWheelChanged="HandlePointerWheelChanged">
        <Grid>
          <Image x:Name="PreviewImageControl" Margin="12" Source="{Binding PreviewImage}" Stretch="Uniform" />
          <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#77819D" FontSize="16"
                     IsVisible="{Binding IsPreviewEmpty}"
                     Text="正在生成可重复的分形预览…" />
        </Grid>
      </Border>

      <ScrollViewer Grid.Column="2" Background="#0E1425" BorderBrush="#27304A" BorderThickness="1,0,0,0">
        <StackPanel Margin="14" Spacing="10">
          <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="#F2F5FF" Text="{Binding GeneratorKindName}" />

          <Expander Header="当前图层与合成" IsExpanded="True">
            <StackPanel Margin="0,8,0,0" Spacing="7">
              <TextBox Text="{Binding SelectedLayerName}" PlaceholderText="图层名称" />
              <CheckBox Foreground="#D4DAED" Content="可见" IsChecked="{Binding SelectedLayerVisible}" />
              <TextBlock Foreground="#BFC7DB" Text="不透明度" />
              <Slider Minimum="0" Maximum="1" TickFrequency="0.05" Value="{Binding SelectedLayerOpacity}" />
              <ComboBox ItemsSource="{Binding BlendModeOptions}" SelectedItem="{Binding SelectedBlendMode}" />
              <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                <NumericUpDown Grid.Column="0" Minimum="-200" Maximum="200" Increment="1" Value="{Binding LayerPositionX}" PlaceholderText="位置 X %" />
                <NumericUpDown Grid.Column="1" Minimum="-200" Maximum="200" Increment="1" Value="{Binding LayerPositionY}" PlaceholderText="位置 Y %" />
              </Grid>
              <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                <NumericUpDown Grid.Column="0" Minimum="1" Maximum="800" Increment="1" Value="{Binding LayerScale}" PlaceholderText="缩放 %" />
                <NumericUpDown Grid.Column="1" Minimum="-180" Maximum="180" Increment="1" Value="{Binding LayerRotation}" PlaceholderText="旋转 °" />
              </Grid>
              <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                <NumericUpDown Grid.Column="0" Minimum="0" Maximum="100" Increment="1" Value="{Binding LayerAnchorX}" PlaceholderText="锚点 X %" />
                <NumericUpDown Grid.Column="1" Minimum="0" Maximum="100" Increment="1" Value="{Binding LayerAnchorY}" PlaceholderText="锚点 Y %" />
              </Grid>
              <ComboBox ItemsSource="{Binding MaskSources}" SelectedItem="{Binding SelectedMaskSource}" PlaceholderText="ScalarField 遮罩源" />
              <StackPanel IsVisible="{Binding HasSelectedMask}" Spacing="6">
                <NumericUpDown Minimum="0" Maximum="1" Increment="0.01" Value="{Binding MaskThreshold}" PlaceholderText="遮罩阈值" />
                <NumericUpDown Minimum="0" Maximum="1" Increment="0.01" Value="{Binding MaskSoftness}" PlaceholderText="遮罩柔化" />
                <CheckBox Foreground="#D4DAED" Content="反相遮罩" IsChecked="{Binding MaskInverted}" />
              </StackPanel>
              <TextBlock Foreground="#8791AD" Text="位置和锚点相对画布保存；正角度顺时针旋转。" TextWrapping="Wrap" />
            </StackPanel>
          </Expander>

          <Expander Header="画布与渲染" IsExpanded="False">
            <StackPanel Margin="0,8,0,0" Spacing="7">
              <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                <NumericUpDown Grid.Column="0" Minimum="64" Maximum="8192" Value="{Binding CanvasWidth}" PlaceholderText="宽度" />
                <NumericUpDown Grid.Column="1" Minimum="64" Maximum="8192" Value="{Binding CanvasHeight}" PlaceholderText="高度" />
              </Grid>
              <TextBox Text="{Binding BackgroundHex}" PlaceholderText="#RRGGBBAA 背景" />
              <NumericUpDown IsVisible="{Binding IsSeedControlVisible}" Minimum="-9223372036854775808" Maximum="9223372036854775807" Value="{Binding Seed}" PlaceholderText="Seed" />
            </StackPanel>
          </Expander>

          <TabControl IsVisible="{Binding IsEscapeTimeFamily}">
            <TabItem Header="示例">
              <StackPanel Margin="8" Spacing="8">
                <StackPanel IsVisible="{Binding IsJuliaGenerator}" Spacing="6">
                  <TextBlock Foreground="#8791AD" Text="Julia 经典起点" />
                  <WrapPanel>
                    <Button Margin="0,0,6,6" Command="{Binding ApplyArtworkPresetCommand}" CommandParameter="amber-bloom" Content="暮金花火" />
                    <Button Margin="0,0,6,6" Command="{Binding ApplyArtworkPresetCommand}" CommandParameter="ocean-velvet" Content="深海丝绒" />
                    <Button Margin="0,0,6,6" Command="{Binding ApplyArtworkPresetCommand}" CommandParameter="neon-coral" Content="霓虹珊瑚" />
                  </WrapPanel>
                </StackPanel>
                <StackPanel IsVisible="{Binding IsMandelbrotGenerator}" Spacing="6">
                  <TextBlock Foreground="#8791AD" Text="Mandelbrot 经典起点" />
                  <WrapPanel>
                    <Button Margin="0,0,6,6" Command="{Binding ApplyArtworkPresetCommand}" CommandParameter="mandelbrot-overview" Content="全景" />
                    <Button Margin="0,0,6,6" Command="{Binding ApplyArtworkPresetCommand}" CommandParameter="mandelbrot-seahorse" Content="海马谷" />
                    <Button Margin="0,0,6,6" Command="{Binding ApplyArtworkPresetCommand}" CommandParameter="mandelbrot-elephant" Content="象谷" />
                  </WrapPanel>
                </StackPanel>
                <TextBlock Foreground="#8791AD" Text="应用示例后仍可在“创作”和“数学”中继续修改。" TextWrapping="Wrap" />
              </StackPanel>
            </TabItem>
            <TabItem Header="创作">
              <StackPanel Margin="8" Spacing="6">
                <TextBlock Foreground="#BFC7DB" Text="细节" />
                <Slider Minimum="0" Maximum="100" TickFrequency="1" Value="{Binding Detail}" />
                <StackPanel IsVisible="{Binding IsJuliaGenerator}" Spacing="6">
                  <TextBlock Foreground="#BFC7DB" Text="流动" />
                  <Slider Minimum="0" Maximum="100" TickFrequency="1" Value="{Binding Flow}" />
                  <TextBlock Foreground="#BFC7DB" Text="卷曲" />
                  <Slider Minimum="0" Maximum="100" TickFrequency="1" Value="{Binding Curl}" />
                </StackPanel>
                <TextBlock Foreground="#8791AD" Text="艺术控件直接映射真实数学参数，不保存第二份状态。" TextWrapping="Wrap" />
              </StackPanel>
            </TabItem>
            <TabItem Header="数学">
              <StackPanel Margin="8" Spacing="7">
                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                  <TextBox Grid.Column="0" Text="{Binding CenterX}" PlaceholderText="中心 X" />
                  <TextBox Grid.Column="1" Text="{Binding CenterY}" PlaceholderText="中心 Y" />
                </Grid>
                <TextBox Text="{Binding Scale}" PlaceholderText="视野尺度，例如 1e-80" />
                <Grid IsVisible="{Binding IsJuliaGenerator}" ColumnDefinitions="*,*" ColumnSpacing="8">
                  <TextBox Grid.Column="0" Text="{Binding ConstantReal}" PlaceholderText="常量实部" />
                  <TextBox Grid.Column="1" Text="{Binding ConstantImaginary}" PlaceholderText="常量虚部" />
                </Grid>
                <NumericUpDown Increment="16" Minimum="16" Maximum="4096" Value="{Binding MaxIterations}" PlaceholderText="最大迭代" />
                <CheckBox Foreground="#D4DAED" Content="强制任意精度" IsChecked="{Binding ForceHighPrecision}" />
                <NumericUpDown Increment="16" Minimum="32" Maximum="1024" Value="{Binding PrecisionDigits}" PlaceholderText="十进制有效位数" />
                <TextBlock Foreground="#8791AD" Text="拖动画布平移；滚轮以鼠标为锚点缩放。数值支持科学计数法。" TextWrapping="Wrap" />
              </StackPanel>
            </TabItem>
            <TabItem Header="外观">
              <StackPanel Margin="8" Spacing="7">
                <WrapPanel>
                  <Button Margin="0,0,6,6" Command="{Binding ApplyPalettePresetCommand}" CommandParameter="gold" Content="琥珀金" />
                  <Button Margin="0,0,6,6" Command="{Binding ApplyPalettePresetCommand}" CommandParameter="cyan" Content="极光青" />
                  <Button Margin="0,0,6,6" Command="{Binding ApplyPalettePresetCommand}" CommandParameter="magenta" Content="玫紫夜" />
                </WrapPanel>
                <TextBox Text="{Binding GradientStartHex}" PlaceholderText="起始 #RRGGBBAA" />
                <TextBox Text="{Binding GradientEndHex}" PlaceholderText="结束 #RRGGBBAA" />
              </StackPanel>
            </TabItem>
          </TabControl>

          <TabControl IsVisible="{Binding IsLSystemGenerator}">
            <TabItem Header="示例">
              <StackPanel Margin="8" Spacing="7">
                <TextBlock Foreground="#8791AD" Text="经典 L-System" />
                <WrapPanel>
                  <Button Margin="0,0,6,6" Command="{Binding ApplyArtworkPresetCommand}" CommandParameter="lsystem-koch" Content="Koch 雪花" />
                  <Button Margin="0,0,6,6" Command="{Binding ApplyArtworkPresetCommand}" CommandParameter="lsystem-dragon" Content="Heighway 龙" />
                  <Button Margin="0,0,6,6" Command="{Binding ApplyArtworkPresetCommand}" CommandParameter="lsystem-sierpinski" Content="Sierpiński" />
                  <Button Margin="0,0,6,6" Command="{Binding ApplyArtworkPresetCommand}" CommandParameter="lsystem-plant" Content="分形植物" />
                  <Button Margin="0,0,6,6" Command="{Binding ApplyArtworkPresetCommand}" CommandParameter="lsystem-hilbert" Content="Hilbert" />
                </WrapPanel>
                <TextBlock Foreground="#8791AD" Text="示例会填入规则和绘制参数，之后可以完全自定义。" TextWrapping="Wrap" />
              </StackPanel>
            </TabItem>
            <TabItem Header="规则">
              <StackPanel Margin="8" Spacing="7">
                <TextBox Text="{Binding LSystemAxiom}" PlaceholderText="公理，例如 F--F--F" />
                <TextBox Height="116" AcceptsReturn="True" TextWrapping="Wrap" Text="{Binding LSystemRulesText}" PlaceholderText="一行一个，例如 F=F+F--F+F" />
                <NumericUpDown Minimum="0" Maximum="12" Value="{Binding LSystemIterations}" PlaceholderText="迭代层级" />
                <TextBlock Foreground="#9FB1D3" Text="{Binding LSystemDiagnostics}" TextWrapping="Wrap" />
                <TextBlock Foreground="#8791AD" Text="支持 A–Z、F/G 绘制、f 移动、+/- 转向、[ ] 分支。展开上限 250,000 符号、50,000 线段。" TextWrapping="Wrap" />
              </StackPanel>
            </TabItem>
            <TabItem Header="绘制">
              <StackPanel Margin="8" Spacing="7">
                <NumericUpDown Minimum="1" Maximum="360" Increment="0.5" Value="{Binding LSystemTurnAngle}" PlaceholderText="转角（度）" />
                <NumericUpDown Minimum="-3600" Maximum="3600" Increment="1" Value="{Binding LSystemInitialHeading}" PlaceholderText="初始方向（度）" />
                <NumericUpDown Minimum="0.0001" Maximum="1" Increment="0.001" Value="{Binding LSystemStepLength}" PlaceholderText="步长" />
                <NumericUpDown Minimum="0.01" Maximum="1" Increment="0.01" Value="{Binding LSystemLengthDecay}" PlaceholderText="长度衰减" />
                <NumericUpDown Minimum="0.5" Maximum="40" Increment="0.5" Value="{Binding LSystemStrokeWidth}" PlaceholderText="基础线宽" />
                <NumericUpDown Minimum="0.01" Maximum="1" Increment="0.01" Value="{Binding LSystemStrokeWidthDecay}" PlaceholderText="线宽衰减" />
              </StackPanel>
            </TabItem>
            <TabItem Header="外观">
              <StackPanel Margin="8" Spacing="7">
                <WrapPanel>
                  <Button Margin="0,0,6,6" Command="{Binding ApplyPalettePresetCommand}" CommandParameter="gold" Content="琥珀金" />
                  <Button Margin="0,0,6,6" Command="{Binding ApplyPalettePresetCommand}" CommandParameter="cyan" Content="极光青" />
                  <Button Margin="0,0,6,6" Command="{Binding ApplyPalettePresetCommand}" CommandParameter="magenta" Content="玫紫夜" />
                </WrapPanel>
                <TextBox Text="{Binding GradientStartHex}" PlaceholderText="起始 #RRGGBBAA" />
                <TextBox Text="{Binding GradientEndHex}" PlaceholderText="结束 #RRGGBBAA" />
              </StackPanel>
            </TabItem>
          </TabControl>

          <TabControl IsVisible="{Binding IsAttractorGenerator}">
            <TabItem Header="预设">
              <StackPanel Margin="8" Spacing="7">
                <TextBlock Foreground="#8791AD" Text="奇异吸引子 · 星云与粒子" />
                <WrapPanel>
                  <Button Margin="0,0,6,6" Command="{Binding ApplyArtworkPresetCommand}" CommandParameter="attractor-aurora" Content="极光织网" />
                  <Button Margin="0,0,6,6" Command="{Binding ApplyArtworkPresetCommand}" CommandParameter="attractor-silk" Content="丝绸星云" />
                  <Button Margin="0,0,6,6" Command="{Binding ApplyArtworkPresetCommand}" CommandParameter="attractor-stardust" Content="星尘花冠" />
                  <Button Margin="0,0,6,6" Command="{Binding ApplyArtworkPresetCommand}" CommandParameter="attractor-abyss" Content="深海回环" />
                </WrapPanel>
                <TextBlock Foreground="#8791AD" Text="预设会设置公式、形态、透明渐变和局部发光；仍可继续编辑。" TextWrapping="Wrap" />
              </StackPanel>
            </TabItem>
            <TabItem Header="公式">
              <StackPanel Margin="8" Spacing="7">
                <ComboBox ItemsSource="{Binding AttractorFormulaOptions}" SelectedItem="{Binding SelectedAttractorFormula}" />
                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                  <NumericUpDown Grid.Column="0" Minimum="-4" Maximum="4" Increment="0.01" Value="{Binding AttractorA}" PlaceholderText="参数 A" />
                  <NumericUpDown Grid.Column="1" Minimum="-4" Maximum="4" Increment="0.01" Value="{Binding AttractorB}" PlaceholderText="参数 B" />
                </Grid>
                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                  <NumericUpDown Grid.Column="0" Minimum="-4" Maximum="4" Increment="0.01" Value="{Binding AttractorC}" PlaceholderText="参数 C" />
                  <NumericUpDown Grid.Column="1" Minimum="-4" Maximum="4" Increment="0.01" Value="{Binding AttractorD}" PlaceholderText="参数 D" />
                </Grid>
                <NumericUpDown Minimum="16" Maximum="4096" Increment="16" Value="{Binding AttractorBurnIn}" PlaceholderText="每轨道预热迭代" />
                <NumericUpDown Minimum="10000" Maximum="2000000" Increment="10000" Value="{Binding AttractorSampleCount}" PlaceholderText="最终采样点数" />
                <TextBlock Foreground="#8791AD" Text="普通预览最多 10 万点，精细预览最多 40 万点；最终导出使用完整采样数。" TextWrapping="Wrap" />
              </StackPanel>
            </TabItem>
            <TabItem Header="密度与发光">
              <StackPanel Margin="8" Spacing="7">
                <NumericUpDown Minimum="0.1" Maximum="32" Increment="0.1" Value="{Binding AttractorExposure}" PlaceholderText="密度曝光" />
                <NumericUpDown Minimum="0.2" Maximum="4" Increment="0.05" Value="{Binding AttractorGamma}" PlaceholderText="Gamma" />
                <CheckBox Foreground="#D4DAED" Content="当前吸引子层局部发光" IsChecked="{Binding AttractorGlowEnabled}" />
                <NumericUpDown Minimum="0.5" Maximum="10" Increment="0.1" Value="{Binding AttractorGlowSigma}" PlaceholderText="发光 Sigma" />
                <NumericUpDown Minimum="0" Maximum="4" Increment="0.1" Value="{Binding AttractorGlowStrength}" PlaceholderText="发光强度" />
                <TextBox Text="{Binding GradientStartHex}" PlaceholderText="低密度 #RRGGBBAA" />
                <TextBox Text="{Binding GradientEndHex}" PlaceholderText="高密度 #RRGGBBAA" />
                <TextBlock Foreground="#8791AD" Text="零密度始终透明；局部发光不会影响其它图层或 Master Bloom。" TextWrapping="Wrap" />
              </StackPanel>
            </TabItem>
          </TabControl>

          <StackPanel IsVisible="{Binding IsRecursiveTreeGenerator}" Spacing="7">
            <TextBlock Foreground="#8791AD" Text="G0005 递归树兼容编辑器" />
            <WrapPanel>
              <Button Margin="0,0,6,6" Command="{Binding ApplyArtworkPresetCommand}" CommandParameter="verdant-growth" Content="翡翠生长" />
              <Button Margin="0,0,6,6" Command="{Binding ApplyArtworkPresetCommand}" CommandParameter="winter-branches" Content="月下银枝" />
            </WrapPanel>
            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
              <NumericUpDown Grid.Column="0" Minimum="1" Maximum="12" Value="{Binding TreeDepth}" PlaceholderText="递归层级" />
              <NumericUpDown Grid.Column="1" Minimum="2" Maximum="3" Value="{Binding TreeBranches}" PlaceholderText="每级分叉" />
            </Grid>
            <NumericUpDown Minimum="5" Maximum="85" Increment="0.5" Value="{Binding TreeBranchAngle}" PlaceholderText="分叉角度" />
            <NumericUpDown Minimum="0.45" Maximum="0.85" Increment="0.01" Value="{Binding TreeLengthDecay}" PlaceholderText="长度衰减" />
            <NumericUpDown Minimum="0" Maximum="1" Increment="0.01" Value="{Binding TreeRandomness}" PlaceholderText="随机度" />
            <NumericUpDown Minimum="0.05" Maximum="0.6" Increment="0.01" Value="{Binding TreeTrunkLength}" PlaceholderText="主干长度" />
            <NumericUpDown Minimum="0.5" Maximum="40" Increment="0.5" Value="{Binding TreeStrokeWidth}" PlaceholderText="基础线宽" />
          </StackPanel>

          <Expander Header="变体探索" IsExpanded="False">
            <StackPanel Margin="0,8,0,0" Spacing="7">
              <NumericUpDown Minimum="0.05" Maximum="1" Increment="0.05" FormatString="0.00" Value="{Binding MutationStrength}" PlaceholderText="变异强度" />
              <WrapPanel>
                <Button Margin="0,0,6,6" Command="{Binding SetVariationModeCommand}" CommandParameter="All" Content="全部" />
                <Button Margin="0,0,6,6" Command="{Binding SetVariationModeCommand}" CommandParameter="ShapeOnly" Content="只变形态" />
                <Button Margin="0,0,6,6" Command="{Binding SetVariationModeCommand}" CommandParameter="TextureOnly" Content="只变质感" />
              </WrapPanel>
              <TextBlock Foreground="#D4DAED" Text="{Binding VariationModeName, StringFormat='当前：{0}'}" />
              <WrapPanel>
                <CheckBox IsVisible="{Binding IsSeedControlVisible}" Margin="0,0,10,4" Foreground="#D4DAED" Content="锁 Seed" IsChecked="{Binding IsSeedLocked}" />
                <CheckBox Margin="0,0,10,4" Foreground="#D4DAED" Content="锁构图" IsChecked="{Binding IsCompositionLocked}" />
                <CheckBox Margin="0,0,10,4" Foreground="#D4DAED" Content="锁形态" IsChecked="{Binding IsShapeLocked}" />
                <CheckBox Margin="0,0,10,4" Foreground="#D4DAED" Content="锁颜色" IsChecked="{Binding IsColorLocked}" />
              </WrapPanel>
              <Button Command="{Binding GenerateVariationsCommand}" Content="生成 9 个可重现候选" />
            </StackPanel>
          </Expander>

          <Expander Header="ImageLab 后处理（仅导出时应用）" IsExpanded="False">
            <StackPanel Margin="0,8,0,0" Spacing="7">
              <TextBlock Foreground="#8791AD" Text="不改变作品和预览；先写临时 PNG，再经 Host Workflow Gateway 调用 ImageLab。" TextWrapping="Wrap" />
              <CheckBox Foreground="#D4DAED" Content="Gaussian Blur" IsChecked="{Binding ImageLabBlurEnabled}" />
              <NumericUpDown Minimum="0" Maximum="10" Increment="0.1" Value="{Binding ImageLabBlurSigma}" PlaceholderText="Blur Sigma" />
              <CheckBox Foreground="#D4DAED" Content="Bloom" IsChecked="{Binding ImageLabBloomEnabled}" />
              <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                <NumericUpDown Grid.Column="0" Minimum="0" Maximum="1" Increment="0.01" Value="{Binding ImageLabBloomThreshold}" PlaceholderText="阈值" />
                <NumericUpDown Grid.Column="1" Minimum="0.1" Maximum="10" Increment="0.1" Value="{Binding ImageLabBloomSigma}" PlaceholderText="Sigma" />
              </Grid>
              <NumericUpDown Minimum="0" Maximum="4" Increment="0.1" Value="{Binding ImageLabBloomStrength}" PlaceholderText="Bloom 强度" />
              <CheckBox Foreground="#D4DAED" Content="Grain" IsChecked="{Binding ImageLabGrainEnabled}" />
              <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                <NumericUpDown Grid.Column="0" Minimum="0" Maximum="100" Increment="0.5" Value="{Binding ImageLabGrainAmount}" PlaceholderText="颗粒强度" />
                <NumericUpDown Grid.Column="1" Minimum="-9223372036854775808" Maximum="9223372036854775807" Value="{Binding ImageLabGrainSeed}" PlaceholderText="Seed" />
              </Grid>
              <Button Command="{Binding ExportWithImageLabCommand}" Content="经 ImageLab 导出 PNG" />
              <Button Command="{Binding ExportWorkflowRecipeCommand}" Content="导出 Workflow 配方" />
            </StackPanel>
          </Expander>

          <Expander Header="Master Effects（作品内实时效果）" IsExpanded="False">
            <StackPanel Margin="0,8,0,0" Spacing="7">
              <CheckBox Foreground="#D4DAED" Content="Tone（色调）" IsChecked="{Binding ToneEnabled}" />
              <NumericUpDown Minimum="-1" Maximum="1" Increment="0.05" Value="{Binding ToneBrightness}" PlaceholderText="亮度" />
              <NumericUpDown Minimum="-1" Maximum="1" Increment="0.05" Value="{Binding ToneContrast}" PlaceholderText="对比度" />
              <NumericUpDown Minimum="0" Maximum="2" Increment="0.05" Value="{Binding ToneSaturation}" PlaceholderText="饱和度" />
              <CheckBox Foreground="#D4DAED" Content="Bloom（辉光）" IsChecked="{Binding MasterBloomEnabled}" />
              <NumericUpDown Minimum="0" Maximum="1" Increment="0.01" Value="{Binding MasterBloomThreshold}" PlaceholderText="阈值" />
              <NumericUpDown Minimum="0.1" Maximum="10" Increment="0.1" Value="{Binding MasterBloomSigma}" PlaceholderText="Sigma" />
              <NumericUpDown Minimum="0" Maximum="4" Increment="0.1" Value="{Binding MasterBloomStrength}" PlaceholderText="强度" />
              <TextBlock Foreground="#8791AD" Text="固定按 Tone → Bloom 执行，并随作品保存、撤销和导出。" TextWrapping="Wrap" />
            </StackPanel>
          </Expander>

          <Button Margin="0,8,0,0" Command="{Binding CancelOperationCommand}" Content="取消当前渲染/导出" IsEnabled="{Binding IsOperationBusy}" />
        </StackPanel>
      </ScrollViewer>
    </Grid>

    <Border Grid.Row="2" MaxHeight="230" Padding="12,8" Background="#0E1425" BorderBrush="#27304A" BorderThickness="0,1,0,0">
      <Grid RowDefinitions="Auto,Auto" RowSpacing="6">
        <ScrollViewer Grid.Row="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
          <ItemsControl ItemsSource="{Binding VariationCandidates}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" Spacing="8" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Width="150" Padding="6" Background="#182038" BorderBrush="#394463" BorderThickness="1" CornerRadius="6">
                  <StackPanel Spacing="5">
                    <Image Height="82" Source="{Binding PreviewImage}" Stretch="UniformToFill" />
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Grid.Column="0" Foreground="#F2F5FF" Text="{Binding Title}" />
                      <TextBlock Grid.Column="1" Foreground="#FFD166" IsVisible="{Binding IsFavorite}" Text="★" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="4">
                      <Button Padding="7,3" Click="HandleApplyVariation" Content="采用" />
                      <Button Padding="7,3" Click="HandleToggleFavorite" Content="收藏" />
                      <Button Padding="7,3" Click="HandleContinueVariation" Content="续变" />
                    </StackPanel>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="6">
          <TextBlock VerticalAlignment="Center" Foreground="#8791AD" Text="收藏：" />
          <ItemsControl ItemsSource="{Binding Favorites}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" Spacing="6" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal" Spacing="3">
                  <Button Click="HandleRestoreFavorite" Content="{Binding Name}" />
                  <Button Click="HandleContinueFavorite" Content="续变" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Grid>
    </Border>

    <Border Grid.Row="3" Padding="12,8" Background="#12182B" BorderBrush="#27304A" BorderThickness="0,1,0,0">
      <TextBlock Foreground="#BFC7DB" Text="{Binding StatusMessage}" TextTrimming="CharacterEllipsis" />
    </Border>
  </Grid>
</UserControl>
